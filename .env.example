# Read-only Solana mainnet endpoints. A dedicated RPC plan with logs subscriptions,
# transaction history and getProgramAccounts for both token programs is recommended.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
DASHBOARD_PORT=3000
DATABASE_PATH=./data/pumptrader.sqlite
# Never put a wallet seed or private key in this file. V1 only simulates trades.
